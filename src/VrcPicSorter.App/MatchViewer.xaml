<Window x:Class="VrcPicSorter.App.MatchViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Match preview" Width="1100" Height="800" MinWidth="500" MinHeight="350"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}"
        Loaded="ViewerLoaded" Closed="ViewerClosed" PreviewKeyDown="ViewerKeyDown">
    <DockPanel Margin="12">
        <TextBlock x:Name="FileTitle" DockPanel.Dock="Top" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Slider x:Name="Zoom" Width="180" Minimum="1" Maximum="8" Value="1" ValueChanged="ZoomChanged" />
            <Button Content="Fit" Click="ResetView" Margin="10,0" />
            <CheckBox x:Name="Pause" Content="Pause" VerticalAlignment="Center" Checked="PlaybackChanged" Unchecked="PlaybackChanged" />
            <Button Content="Close (Esc)" Click="CloseViewer" Margin="12,0,0,0" />
        </WrapPanel>
        <Grid Background="{StaticResource PreviewBackdropBrush}" ClipToBounds="True"
              MouseLeftButtonDown="PanStarted" MouseMove="PanMoved" MouseLeftButtonUp="PanEnded" MouseWheel="ZoomWheel">
            <Image x:Name="Preview" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform><TransformGroup><ScaleTransform x:Name="Scale" /><TranslateTransform x:Name="Pan" /></TransformGroup></Image.RenderTransform>
            </Image>
            <TextBlock x:Name="Status" Text="Loading image…" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </DockPanel>
</Window>
