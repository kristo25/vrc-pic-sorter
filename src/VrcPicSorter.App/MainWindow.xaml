<Window x:Class="VrcPicSorter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="VRC Pic Sorter"
        Width="1280"
        Height="820"
        MinWidth="920"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.RowSpan="2" VerticalAlignment="Center">
                    <TextBlock FontSize="21" FontWeight="SemiBold" Text="VRC Pic Sorter" />
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="12" Text="Local duplicate review" />
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ReviewNavButton" Content="Review" Margin="0,0,8,0" Click="ShowReviewPage" automation:AutomationProperties.Name="Open review queue" />
                    <Button x:Name="AnimationsNavButton" Content="Animations" Margin="0,0,8,0" Click="ShowAnimationsPage" automation:AutomationProperties.Name="Open animated emoji" />
                    <Button x:Name="HistoryNavButton" Content="History" Margin="0,0,8,0" Click="ShowHistoryPage" automation:AutomationProperties.Name="Open activity history" />
                    <Button x:Name="SettingsNavButton" Content="Settings" Click="ShowSettingsPage" automation:AutomationProperties.Name="Open settings" />
                </StackPanel>
                <WrapPanel Grid.Column="1" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="WatchStatusText" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="Not watching" />
                    <TextBlock x:Name="QueueCountText" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                    <Button x:Name="ScanAnotherButton" Content="Scan another folder" Margin="0,0,8,0" Click="ScanAnotherFolder" automation:AutomationProperties.Name="Select and scan another image folder" />
                    <Button x:Name="WatchButton" Content="Start watching" Margin="0,0,8,0" Click="ToggleWatching" automation:AutomationProperties.Name="Start watching configured image folders" />
                    <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}" Content="Scan now" Margin="0,0,8,0" Click="ScanNow" automation:AutomationProperties.Name="Scan enabled image folders now" />
                    <Button x:Name="StopButton" Style="{StaticResource DangerButton}" Content="Stop" IsEnabled="False" Click="StopCurrentOperation" automation:AutomationProperties.Name="Stop the running scan" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="{StaticResource WindowBrush}">
            <Grid x:Name="ReviewPage" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="420" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ReviewHeading" Focusable="True" FontSize="17" FontWeight="SemiBold" Text="Review queue" VerticalAlignment="Center" />
                        <Button x:Name="ClearQueueButton" Grid.Column="1" Content="Clear queue" Padding="9,5" Click="ClearReviewQueue" automation:AutomationProperties.Name="Clear the review queue without deleting incoming files" />
                    </Grid>
                    <ListBox x:Name="QueueList"
                             SelectionChanged="QueueSelectionChanged"
                             automation:AutomationProperties.Name="Pending image review queue">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Category}" />
                                    <TextBlock FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="{Binding IncomingOriginalPath}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12" Foreground="{StaticResource PurpleHoverBrush}" Text="{Binding Candidates.Count, StringFormat={}{0} match(es)}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ReviewTitle" FontSize="17" FontWeight="SemiBold" Text="Select an item to review" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ReviewSubtitle" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            <TextBlock x:Name="IncomingResolutionText" Foreground="{StaticResource PurpleHoverBrush}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock x:Name="IncomingAvailabilityText" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            <TextBlock x:Name="IncomingLocationText"
                                       MaxWidth="610"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       automation:AutomationProperties.Name="Incoming image locations" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="Zoom" Margin="0,0,8,0" />
                            <Slider x:Name="ZoomSlider" Width="110" Minimum="0.5" Maximum="2.5" Value="1" TickFrequency="0.25" ValueChanged="ZoomChanged" automation:AutomationProperties.Name="Incoming preview zoom" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource PreviewBackdropBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                        <Grid>
                            <Image x:Name="IncomingPreview" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" automation:AutomationProperties.Name="Incoming image preview">
                                <Image.RenderTransform><ScaleTransform x:Name="IncomingScale" ScaleX="1" ScaleY="1" /></Image.RenderTransform>
                            </Image>
                            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="7,4" Background="#CC1B1C22" Text="Incoming" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="MoveUniqueButton" Style="{StaticResource PrimaryButton}" Content="Move as Unique" Click="MoveAsUnique" automation:AutomationProperties.Name="Reject all matches and move incoming image as unique" />
                        <Button x:Name="RemoveReviewButton" Margin="8,0,0,0" Content="Remove from Queue" Click="RemoveSelectedReview" automation:AutomationProperties.Name="Remove selected item from the review queue without deleting its incoming file" />
                    </StackPanel>
                </Grid>

                <DockPanel Grid.Column="4">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="Matches" />
                        <TextBlock x:Name="CandidateHint" Margin="0,3,0,10" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="No pending matches." />
                    </StackPanel>
                    <ListBox x:Name="CandidateList"
                             BorderThickness="0"
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             automation:AutomationProperties.Name="All matching archive candidates">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="10" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="150" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Background="{StaticResource PreviewBackdropBrush}" CornerRadius="4">
                                            <Image Tag="{Binding ArchivePath}" Loaded="CandidatePreviewLoaded" Unloaded="CandidatePreviewUnloaded" Stretch="Uniform" automation:AutomationProperties.Name="Archive match preview" />
                                        </Border>
                                        <Grid Grid.Row="1" Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding MatchLabel}" />
                                            <TextBlock Grid.Column="1" Foreground="{StaticResource PurpleHoverBrush}" FontWeight="SemiBold" Text="{Binding Resolution}" />
                                        </Grid>
                                        <TextBlock Grid.Row="2" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="{Binding ArchivePath}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding ArchivePath}" />
                                        <TextBlock Grid.Row="3" Margin="0,4,0,8" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Details}" TextWrapping="Wrap" />
                                        <Grid Grid.Row="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource PrimaryButton}" Content="Keep Incoming" CommandParameter="{Binding Candidate}" Click="KeepIncoming" automation:AutomationProperties.Name="Keep incoming image instead of this archive match" />
                                            <Button Grid.Column="2" Content="Keep Match" CommandParameter="{Binding Candidate}" Click="KeepMatch" automation:AutomationProperties.Name="Keep this archive match instead of the incoming image" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>

            <Grid x:Name="AnimationsPage" Visibility="Collapsed" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="AnimationsHeading" Focusable="True" FontSize="22" FontWeight="SemiBold" Text="Animated emoji" />
                        <TextBlock x:Name="AnimationsSubtitle" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                   Text="VRChat records the frame count, rate and loop direction in the file name, and that is what the animation follows. Correct any of the three below when a name is wrong." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Orientation="Horizontal">
                        <CheckBox x:Name="ShowExportedCheck" Content="Show exported" VerticalAlignment="Center" Margin="0,0,12,0"
                                  Checked="AnimationFilterChanged" Unchecked="AnimationFilterChanged"
                                  automation:AutomationProperties.Name="Also list emoji that are already exported" />
                        <CheckBox x:Name="ShowSkippedCheck" Content="Show skipped" VerticalAlignment="Center" Margin="0,0,12,0"
                                  Checked="AnimationFilterChanged" Unchecked="AnimationFilterChanged"
                                  automation:AutomationProperties.Name="Also list emoji you have skipped" />
                        <Button x:Name="ClearAnimationQueueButton" Padding="9,5" Margin="0,0,8,0" Content="Clear queue"
                                Click="ClearAnimationQueue" automation:AutomationProperties.Name="Skip every emoji still waiting on a decision" />
                        <Button x:Name="ExportMissingButton" Padding="9,5" Content="Export missing"
                                Click="ExportMissingAnimations" automation:AutomationProperties.Name="Export every animation that is missing" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="SheetList" Margin="0,0,16,0" SelectionChanged="SheetSelected"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             automation:AutomationProperties.Name="Animated emoji in the archive">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <DockPanel Grid.Column="1">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock x:Name="SheetTitle" FontSize="17" FontWeight="SemiBold" Text="Select an emoji to preview" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SheetStatusText" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="0">
                            <WrapPanel>
                                <TextBlock Text="Frames" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="SheetFrames" Width="64" Margin="0,0,16,0" LostFocus="SheetOverrideChanged"
                                         automation:AutomationProperties.Name="Frame count" />
                                <TextBlock Text="Frames per second" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="SheetRate" Width="64" Margin="0,0,16,0" LostFocus="SheetOverrideChanged"
                                         automation:AutomationProperties.Name="Frames per second" />
                                <TextBlock Text="Loop" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox x:Name="SheetLoop" Width="130" Margin="0,0,16,0"
                                          SelectionChanged="SheetOverrideSelected"
                                          automation:AutomationProperties.Name="Loop direction">
                                    <ComboBoxItem Content="Linear" />
                                    <ComboBoxItem Content="Ping-pong" />
                                </ComboBox>
                                <Button x:Name="SkipSheetButton" Padding="9,5" Margin="0,0,8,0" Content="Skip" IsEnabled="False"
                                        Click="SkipSelectedAnimation" automation:AutomationProperties.Name="Skip this emoji" />
                                <Button x:Name="ExportSheetButton" Style="{StaticResource PrimaryButton}" Content="Export GIF" IsEnabled="False"
                                        Click="ExportSelectedAnimation" automation:AutomationProperties.Name="Export this animation" />
                            </WrapPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="2,0,0,6" FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="The sheet, with every cell the animation uses outlined" />
                            <TextBlock x:Name="SheetPreviewCaption" Grid.Row="0" Grid.Column="2" Margin="2,0,0,6" FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="What the GIF will look like" />

                            <!-- The sheet and its grid are laid out at the sheet's own pixel size
                                 inside a Viewbox, so one scale applies to both and the outlines
                                 cannot drift away from the cells they describe. -->
                            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource PreviewBackdropBrush}"
                                    CornerRadius="6" Padding="10">
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                    <Grid x:Name="SheetAtlasHost">
                                        <Image x:Name="SheetAtlasImage"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               automation:AutomationProperties.Name="The sheet being reviewed" />
                                        <UniformGrid x:Name="SheetCellOverlay" />
                                    </Grid>
                                </Viewbox>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource PreviewBackdropBrush}"
                                    CornerRadius="6" Padding="10">
                                <Image x:Name="SheetPreview" Stretch="Uniform" StretchDirection="DownOnly"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       automation:AutomationProperties.Name="Animation preview" />
                            </Border>
                        </Grid>
                    </DockPanel>
                </Grid>
            </Grid>

            <Grid x:Name="HistoryPage" Visibility="Collapsed" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock x:Name="HistoryHeading" Focusable="True" FontSize="22" FontWeight="SemiBold" Text="Activity history" />
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Scans, moves, review decisions, warnings, retries, and deletion requests." />
                </StackPanel>
                <ListView x:Name="HistoryList" Grid.Row="1" automation:AutomationProperties.Name="Activity history">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Time" Width="160" DisplayMemberBinding="{Binding OccurredUtc.LocalDateTime, StringFormat=yyyy-MM-dd HH:mm:ss}" />
                            <GridViewColumn Header="Category" Width="100" DisplayMemberBinding="{Binding Category}" />
                            <GridViewColumn Header="Type" Width="150" DisplayMemberBinding="{Binding Kind}" />
                            <GridViewColumn Header="Message" Width="560" DisplayMemberBinding="{Binding Message}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>

            <ScrollViewer x:Name="SettingsPage"
                          Visibility="Collapsed"
                          Background="{StaticResource WindowBrush}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <StackPanel Margin="24" MaxWidth="1100" HorizontalAlignment="Left">
                    <TextBlock x:Name="SettingsHeading" Focusable="True" FontSize="22" FontWeight="SemiBold" Text="Settings" />
                    <TextBlock Margin="0,2,0,20" Foreground="{StaticResource MutedTextBrush}" Text="Choose VRCX source folders and one output root. Existing archive files are never reorganized." />

                    <TextBlock FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" Text="Folders" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Emoji" />
                        <TextBox x:Name="EmojiSource" Grid.Column="1" LostFocus="SettingsFieldCommitted" KeyDown="SettingsFieldKeyDown" automation:AutomationProperties.Name="Emoji source folder" />
                        <Button Grid.Column="2" Margin="6,0" Padding="8" Content="..." Tag="EmojiSource" Click="BrowseFolder" automation:AutomationProperties.Name="Browse Emoji source folder" />
                        <CheckBox x:Name="EmojiEnabled" Grid.Column="3" Content="Enabled" Checked="SettingsToggled" Unchecked="SettingsToggled" automation:AutomationProperties.Name="Enable Emoji source" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Prints" />
                        <TextBox x:Name="PrintsSource" Grid.Column="1" LostFocus="SettingsFieldCommitted" KeyDown="SettingsFieldKeyDown" automation:AutomationProperties.Name="Prints source folder" />
                        <Button Grid.Column="2" Margin="6,0" Padding="8" Content="..." Tag="PrintsSource" Click="BrowseFolder" automation:AutomationProperties.Name="Browse Prints source folder" />
                        <CheckBox x:Name="PrintsEnabled" Grid.Column="3" Content="Enabled" Checked="SettingsToggled" Unchecked="SettingsToggled" automation:AutomationProperties.Name="Enable Prints source" />
                    </Grid>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Stickers" />
                        <TextBox x:Name="StickersSource" Grid.Column="1" LostFocus="SettingsFieldCommitted" KeyDown="SettingsFieldKeyDown" automation:AutomationProperties.Name="Stickers source folder" />
                        <Button Grid.Column="2" Margin="6,0" Padding="8" Content="..." Tag="StickersSource" Click="BrowseFolder" automation:AutomationProperties.Name="Browse Stickers source folder" />
                        <CheckBox x:Name="StickersEnabled" Grid.Column="3" Content="Enabled" Checked="SettingsToggled" Unchecked="SettingsToggled" automation:AutomationProperties.Name="Enable Stickers source" />
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Main output folder" />
                            <TextBlock FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="Category and source subfolders are preserved." />
                        </StackPanel>
                        <TextBox x:Name="OutputRoot" Grid.Column="1" TextChanged="OutputRootChanged" LostFocus="SettingsFieldCommitted" KeyDown="SettingsFieldKeyDown" automation:AutomationProperties.Name="Main output folder" />
                        <Button Grid.Column="2" Margin="6,0,0,0" Padding="8" Content="..." Tag="OutputRoot" Click="BrowseFolder" automation:AutomationProperties.Name="Browse main output folder" />
                    </Grid>

                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Resolved destinations" />
                            <TextBlock x:Name="EmojiDestinationText" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock x:Name="PrintsDestinationText" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock x:Name="StickersDestinationText" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Similarity" />
                            <TextBlock FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="Conservative is recommended." />
                        </StackPanel>
                        <ComboBox x:Name="SimilarityCombo" Grid.Column="1" SelectionChanged="SettingsSelectionChanged" />
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Archive folders" />
                            <TextBlock FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                       Text="Where an image is filed under its category folder. Existing files are not moved." />
                        </StackPanel>
                        <ComboBox x:Name="OrganizationCombo" Grid.Column="1" VerticalAlignment="Top" SelectionChanged="SettingsSelectionChanged"
                                  automation:AutomationProperties.Name="Where archived images are filed" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="While watching" />
                            <TextBlock FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="OnDetection analyzes each image as it arrives. OnInterval ignores individual arrivals and sweeps on a timer." />
                        </StackPanel>
                        <ComboBox x:Name="WatchModeCombo" Grid.Column="1" VerticalAlignment="Top" SelectionChanged="SettingsSelectionChanged" automation:AutomationProperties.Name="When watching analyzes images" />
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Sweep interval" />
                            <TextBlock FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="Seconds between sweeps. Used only by OnInterval." />
                        </StackPanel>
                        <TextBox x:Name="WatchScanSeconds" Grid.Column="1" VerticalAlignment="Top" LostFocus="SettingsFieldCommitted" KeyDown="SettingsFieldKeyDown" automation:AutomationProperties.Name="Seconds between sweeps while watching" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <CheckBox x:Name="StartWithWindowsCheck" Margin="0,0,28,0" Content="Start with Windows" Checked="SettingsToggled" Unchecked="SettingsToggled" />
                        <CheckBox x:Name="BringReviewForwardCheck" Content="Bring Review forward when a match is queued" Checked="SettingsToggled" Unchecked="SettingsToggled" />
                    </StackPanel>
                    <TextBlock x:Name="StartupStatusText" Margin="0,-12,0,20" Foreground="{StaticResource MutedTextBrush}" automation:AutomationProperties.Name="Windows startup registration status" />

                    <TextBlock x:Name="SettingsNoticeText" Margin="0,0,0,10" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Text="Settings save automatically." automation:AutomationProperties.Name="Settings status" />

                    <WrapPanel Margin="0,0,0,28">
                        <Button Style="{StaticResource PrimaryButton}" Content="Rebuild indexes" Click="RebuildIndexes" automation:AutomationProperties.Name="Rebuild enabled archive indexes" />
                    </WrapPanel>

                    <!-- Collapsed unless something is actually left behind. A section that tells a
                         person their archive is in one piece is noise on every other visit. -->
                    <Border x:Name="RetainedArchivesPanel" Visibility="Collapsed"
                            Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="16" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Retained archives" />
                            <TextBlock x:Name="RetainedArchivesSummary" Margin="0,3,0,12" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="Images filed here before you changed the output folder. They are still recognised, so duplicates are found across both, but they are not in your current archive." />
                            <ItemsControl x:Name="RetainedArchivesList" Margin="0,0,0,12"
                                          automation:AutomationProperties.Name="Archive folders left behind by an output folder change">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding From}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding From}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{StaticResource PurpleHoverBrush}" FontWeight="SemiBold"
                                                       Text="{Binding Summary}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="MoveRetainedArchivesButton" HorizontalAlignment="Left"
                                    Style="{StaticResource PrimaryButton}" Content="Move them into my archive"
                                    Click="MoveRetainedArchives"
                                    automation:AutomationProperties.Name="Move retained archive folders into the current archive" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="ArchiveDuplicatesPanel" Visibility="Collapsed"
                            Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="16" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Duplicates in the archive" />
                            <TextBlock x:Name="ArchiveDuplicatesSummary" Margin="0,3,0,12" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <ItemsControl x:Name="ArchiveDuplicatesList" Margin="0,0,0,12"
                                          automation:AutomationProperties.Name="Images the archive is holding more than once">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Extra}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Detail}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{StaticResource PurpleHoverBrush}" FontWeight="SemiBold"
                                                       Text="{Binding Summary}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="RemoveIdenticalDuplicatesButton" HorizontalAlignment="Left"
                                    Style="{StaticResource PrimaryButton}" Content="Recycle the extra copies"
                                    Click="RemoveIdenticalDuplicates"
                                    automation:AutomationProperties.Name="Send the extra copies the app can prove are duplicates to the Recycle Bin" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="16" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Operation recovery" />
                            <TextBlock x:Name="RecoveryStatusText" Margin="0,3,0,12" Foreground="{StaticResource MutedTextBrush}" Text="No file operations need attention." />
                            <WrapPanel>
                                <Button x:Name="RetryRecoveryButton" Content="Retry safe operations" Margin="0,0,8,0" Click="RetryRecovery" automation:AutomationProperties.Name="Retry file operations that are safe to resume" />
                                <Button x:Name="DismissRecoveryButton" Style="{StaticResource DangerButton}" Content="Dismiss ambiguous operations" Click="DismissRecovery" automation:AutomationProperties.Name="Dismiss ambiguous operations without changing files" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="5" Padding="16">
                        <StackPanel>
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Local data" />
                            <TextBlock Margin="0,3,0,12" Foreground="{StaticResource MutedTextBrush}" Text="Clears settings, cache, index, and history. This is blocked while reviews or file operations are pending." />
                            <Button HorizontalAlignment="Left" Style="{StaticResource DangerButton}" Content="Clear local data" Click="ClearLocalData" automation:AutomationProperties.Name="Clear application data" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="Ready" TextTrimming="CharacterEllipsis" automation:AutomationProperties.LiveSetting="Polite" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <StackPanel x:Name="ScanProgressPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                        <TextBlock x:Name="ScanProgressLabel" Width="92" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Text="Reading" />
                        <ProgressBar x:Name="ScanProgressBar" Width="150" Height="10" Minimum="0" Maximum="1" automation:AutomationProperties.Name="Image reading progress" />
                        <TextBlock x:Name="ScanProgressText" Width="76" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="ScanFileText" Width="170" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" automation:AutomationProperties.Name="File being read" />
                    </StackPanel>
                    <StackPanel x:Name="ProcessingProgressPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="Results" />
                        <ProgressBar x:Name="ProcessingProgressBar" Width="150" Height="10" Minimum="0" Maximum="1" automation:AutomationProperties.Name="Scan results processing progress" />
                        <TextBlock x:Name="ProcessingProgressText" Width="76" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="ProcessingActivityText" Width="230" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" automation:AutomationProperties.Name="Most recent scan outcome" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
