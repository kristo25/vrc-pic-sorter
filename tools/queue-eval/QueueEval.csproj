<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <BaselineImageSharpPath Condition="'$(BaselineImageSharpPath)' == ''">$(UserProfile)/.nuget/packages/sixlabors.imagesharp/3.1.12/lib/net6.0/SixLabors.ImageSharp.dll</BaselineImageSharpPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(Baseline)' != 'true'"><ProjectReference Include="../../src/VrcPicSorter.Core/VrcPicSorter.Core.csproj" /></ItemGroup>
  <ItemGroup Condition="'$(Baseline)' == 'true'">
    <Reference Include="VrcPicSorter.Core"><HintPath>baseline-core/VrcPicSorter.Core.dll</HintPath></Reference>
    <Reference Include="SixLabors.ImageSharp"><HintPath>$(BaselineImageSharpPath)</HintPath></Reference>
  </ItemGroup>
</Project>
